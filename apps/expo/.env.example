# Copy to .env.local and fill in. NEVER commit .env.local (gitignored via *.local).
# Expo exposes EXPO_PUBLIC_* vars to the client bundle — these hold no secrets:
# the PB token lives in the auth store, API keys live on the user's PB record.

# PocketBase instance (mirrors + auth)
EXPO_PUBLIC_PB_URL=https://intervals.pockethost.io

# intervals-coach Cloudflare Worker (chat SSE, proposals, sync)
# Local dev: wrangler dev default port; production: https://intervals-coach.<account>.workers.dev
EXPO_PUBLIC_WORKER_URL=http://localhost:8787
