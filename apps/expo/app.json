{
  "expo": {
    "name": "intervals coach",
    "slug": "intervals-coach",
    "version": "0.1.0",
    "scheme": "intervals",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111111",
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
