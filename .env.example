# Copy to .env and fill in. NEVER commit .env (gitignored).
# .env is used by tools/ scripts and local wrangler only — the apps read
# runtime config from PocketBase / Worker env, not from this file.

# PocketBase (intervals instance on pockethost)
PB_URL=https://intervals.pockethost.io
PB_EMAIL=your-superuser-email
PB_PASSWORD=

# intervals.icu (Nick's own account — for dev seeding + prompt evals)
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=i167187

# OpenRouter (prompt evals only; the app is BYO-key per user)
OPENROUTER_API_KEY=

# Cloudflare (CI deploys; the same values live as Gitea repo secrets)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=9791c391ce704bba4bf263f8eea4ad83

# Worker dev vars (apps/worker/.dev.vars, gitignored)
# PB_URL / PB_EMAIL / PB_PASSWORD as above

# Replicate (asset generation for the design pass: gpt-image / flux models)
REPLICATE_API_TOKEN=
